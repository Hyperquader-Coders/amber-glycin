#!/usr/bin/env bash
# Assert the -dev package's .pc files point inside the bundle: libdir is the bundle's
# directory and includedir its include/ folder, so a program that builds against them
# compiles with the bundle's headers and links the bundle's libraries.
#
# pkg-config reads a file's Requires before it answers for a variable: glycin-gtk4-2 requires
# glycin-2, found beside it, and gtk4 >= 4.16, which Mint's 4.14 does not satisfy, so the
# caller names a GTK 4.16 pkg-config directory in PKG_CONFIG_PATH (the Makefile passes the
# GTK stage's).
#
#   PKG_CONFIG_PATH=<gtk4-pc-dir> scripts/check-pc build/deb/amber-glycin-dev/usr/lib/amber-glycin/pkgconfig /usr/lib/amber-glycin
set -uo pipefail

DIR=${1:?usage: check-pc <pkgconfig-dir> <install-dir>}
INSTALL_DIR=${2:?usage: check-pc <pkgconfig-dir> <install-dir>}
export PKG_CONFIG_PATH=$DIR${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}

fail=0
n=0
for pc in glycin-2 glycin-gtk4-2; do
	f=$DIR/$pc.pc
	if [ ! -e "$f" ]; then
		echo "PC: $pc.pc is missing"
		fail=1
		continue
	fi
	n=$((n + 1))
	grep -qx "prefix=/usr" "$f" || {
		echo "PC: $pc.pc has no bare prefix=/usr line"
		fail=1
	}
	for var in libdir includedir; do
		have=$(pkg-config --define-variable=prefix=/usr --variable="$var" "$f")
		want=$INSTALL_DIR
		[ "$var" = includedir ] && want=$INSTALL_DIR/include
		[ "$have" = "$want" ] || {
			echo "PC: $pc.pc has $var=$have, not $want"
			fail=1
		}
	done
done

[ "$fail" -eq 0 ] || exit 1
echo "pc OK: $n .pc files, libdir $INSTALL_DIR, includedir $INSTALL_DIR/include"
